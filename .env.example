# Template for .env — copy this file and fill in your keys:
#   cp .env.example .env
# Safe to commit. The real .env is git-ignored.

# Required. https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Recommended. Free tier: 1,000 credits/month, no credit card.
# https://www.tavily.com
TAVILY_API_KEY=tvly-...

# Optional — only if a lab targets these providers through aisuite.
ANTHROPIC_API_KEY=
MISTRAL_API_KEY=
