# Secrets
.env

# Environment
venv/
__pycache__/
*.py[cod]
.ipynb_checkpoints/

# Generated output
projects/research-agent/reports/
projects/research-agent/traces/
projects/research-agent/.cache/

# chart-agent: 실행 결과는 커밋한다 — 실행끼리 비교해야 프로세스를 개선할 수 있고,
# LLM 이 비결정적이라 재실행으로는 같은 결과를 얻을 수 없다.
# 다만 subprocess 작업 폴더(실패한 실행에만 남는다)는 제외한다.
projects/chart-agent/runs/*/v*_work/

# sql-agent: DB 는 생성물이다. 생성기가 시드 고정이라 언제든 같은 파일이 나온다.
projects/sql-agent/*.db
projects/sql-agent/**/*.db

# macOS
.DS_Store
